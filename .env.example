# Supabase Configuration (Free Tier at https://supabase.com)
# Obtain these from: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Shop Contact & WhatsApp Configuration (For 1-Click Orders & Inquiries)
# Use international format without + or spaces, e.g. 15551234567 or 94771234567
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=15551234567
NEXT_PUBLIC_SHOP_PHONE=+1 (555) 123-4567
NEXT_PUBLIC_SHOP_EMAIL=sales@lankahardware.com
NEXT_PUBLIC_SHOP_NAME=Lanka Hardware
NEXT_PUBLIC_SHOP_ADDRESS=128 Industrial Parkway, Builder District

# Admin Passcode (Default for local development / quick admin access)
ADMIN_PASSCODE=admin123
